# ============================================================
# AI 社区平台 后端环境变量配置
# ============================================================

# ---------- 基础配置 ----------
# 环境类型
NODE_ENV=development

# 服务端口
PORT=3001

# 前端来源（用于 CORS，多个用逗号分隔）
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# ---------- 数据库 ----------
# PostgreSQL（生产默认；建议每个应用使用独立 schema）
DATABASE_URL="postgresql://user:password@db-host:5432/aicommunity?schema=ai_community"
# 仅迁移或本地回归时使用的旧 SQLite：
# DATABASE_URL="file:./dev.db"
# LEGACY_SQLITE_DATABASE_URL="file:./prisma/dev.db"

# ---------- 认证与登录（v1.4） ----------
# JWT 签名密钥（必填，建议使用 `openssl rand -base64 32` 生成 32 位以上随机串）
AUTH_SECRET=
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ---------- 企业微信 OAuth（v1.4）----------
# 获取位置：企业微信管理后台 → 应用管理 → 自建应用
# 企业 ID（我的企业 → 企业信息）
WECOM_CORP_ID=
# 自建应用 AgentId
WECOM_AGENT_ID=
# 自建应用 Secret
WECOM_SECRET=
# OAuth 回调地址（必须与企业微信后台"网页授权及JS-SDK"配置的回调域一致）
# 格式：https://your-domain.com/api/auth/wecom/callback
WECOM_REDIRECT_URI=

# ---------- 文件上传（v1.3）----------
# 上传限制
MAX_COVER_SIZE_MB=5
MAX_ATTACHMENT_SIZE_MB=50

# 文件存储：本地开发使用 local；多实例生产环境使用 cos
STORAGE_DRIVER=local
# FILE_STORAGE_DRIVER=cos
# COS_BUCKET=your-bucket-appid
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_DOMAIN=https://your-bucket-appid.cos.ap-guangzhou.myqcloud.com
