# Nginx 配置示例
# 部署路径：/etc/nginx/conf.d/ai-community.conf
# 测试：nginx -t
# 重载：nginx -s reload

server {
    listen 80;
    server_name aicommunity-test.cdf-hn.com;

    # HTTP 强制跳转 HTTPS（企微回调要求 HTTPS）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aicommunity-test.cdf-hn.com;

    # SSL 证书路径（请替换为实际路径）
    ssl_certificate     /etc/nginx/ssl/aicommunity-test.cdf-hn.com.pem;
    ssl_certificate_key /etc/nginx/ssl/aicommunity-test.cdf-hn.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 前端静态资源
    root /opt/ai-community/apps/web/dist;
    index index.html;

    # 企业微信可信域名校验文件（如有）
    location ~ ^/WW_verify_.*\.txt$ {
        root /opt/ai-community/apps/web/dist;
    }

    # 后端 API 反向代理
    # ^~ prevents the image/font regex below from intercepting API URLs such as
    # /api/uploads/covers/example.jpg and returning a false static-file 404.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 上传文件大小限制
        client_max_body_size 50M;
    }

    # 上传文件静态访问
    location ^~ /uploads/ {
        alias /opt/ai-community/apps/api/uploads/;
        expires 7d;
    }

    # 前端路由（SPA fallback）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # gzip 压缩
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    gzip_min_length 1000;
}
